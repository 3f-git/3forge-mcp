{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 2,
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "3forge_runtime": {
      "type": "remote",
      "url": "https://YOUR-HOST:33333/3forge_rest/mcp",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Basic {env:AMI_MCP_BASIC_AUTH}"
      }
    }
  }
}
